# ─── SugarScan AI — Backend Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── Server ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ─── Supabase (service-role key — NEVER expose to clients) ───────────────────
# Get from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PASTE_SERVICE_ROLE_KEY_HERE

# ─── AI / Ollama ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=moondream
OLLAMA_LLM_MODEL=phi3:mini
OLLAMA_CHAT_MODEL=phi3:mini

# ─── Legacy (only needed if old SQLAlchemy routes are still active) ───────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/sugarscan
SECRET_KEY=change-this-to-a-random-64-char-secret-key-for-jwt

# ─── CORS (JSON array of allowed origins) ─────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:8081","exp://192.168.1.100:8081","https://Niranjan6699.github.io"]

# ─── Storage ──────────────────────────────────────────────────────────────────
MEDIA_DIR=./media/uploads
MAX_IMAGE_SIZE_MB=10
